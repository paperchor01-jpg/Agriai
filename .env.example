# ====================================================================
# AgriAI — Smart Crop Advisory & Early Warning System (SIH25010)
# Production Environment Variable Template
# ====================================================================

# --------------------------------------------------------------------
# 1. Supabase Infrastructure (Database, Auth, Storage, RLS)
# --------------------------------------------------------------------
# Retrieve from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-Side Only Service Role Key (NEVER expose to client side / NEVER use NEXT_PUBLIC_ prefix)
# Used for background maintenance jobs, audit logging, and automated cleanup routines
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --------------------------------------------------------------------
# 2. Distributed Rate Limiting & Cache (Tier 1: Upstash Redis - Optional)
# --------------------------------------------------------------------
# If not configured, AgriAI automatically falls back to:
# Tier 2: Supabase PostgreSQL atomic increment_rate_limit() RPC
# Tier 3: In-memory sliding window cache
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here

# --------------------------------------------------------------------
# 3. AI Vision & Diagnostic Models (AI Crop Doctor & Copilot)
# --------------------------------------------------------------------
# Primary: Google Gemini 2.5 Flash (Obtain free from Google AI Studio: https://aistudio.google.com/)
# Strictly server-side only in /api/crop-diagnosis
GEMINI_API_KEY=AIzaSy...
AI_API_KEY=

# Secondary / Fallback: OpenAI GPT-4o-mini
OPENAI_API_KEY=sk-...

# --------------------------------------------------------------------
# 4. Weather Telemetry Services
# --------------------------------------------------------------------
# AgriAI defaults to Open-Meteo (Free, high precision, no key required).
# Clustered coordinate caching (~1.1km grid) minimizes external API calls by 90%.
# Optional: WeatherAPI.com forecast key
WEATHER_API_KEY=

# --------------------------------------------------------------------
# 5. Interactive Mapping & Geocoding (Optional)
# --------------------------------------------------------------------
# Optional: Google Maps Platform JavaScript API Key for interactive satellite field picker
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --------------------------------------------------------------------
# 6. Logging & Observability
# --------------------------------------------------------------------
# Logging levels: debug | info | warn | error
LOG_LEVEL=info
# Set to 'true' in production/CI to enforce structured single-line JSON logs
FORCE_JSON_LOGS=false

