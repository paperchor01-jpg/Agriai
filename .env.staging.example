# ====================================================================
# AgriAI — Staging Environment Template (SIH25010)
# Target: AgriAI Staging Deployment (Vercel Preview / Staging)
# ====================================================================
# INSTRUCTIONS FOR VERCEL STAGING SETUP:
# 1. Open Vercel Dashboard -> AgriAI Project -> Settings -> Environment Variables.
# 2. Add each variable below, selecting "Preview" (and optionally "Development").
# 3. For Supabase values, copy from your NEW "AgriAI Staging" Supabase project:
#    Supabase Dashboard -> Settings -> API.
# 4. NEVER check in a filled .env.staging or .env.staging.local into Git.
# ====================================================================

# --------------------------------------------------------------------
# 1. Supabase Staging Project (Database, Auth, Storage, RLS)
# --------------------------------------------------------------------
# Staging Supabase Project URL (Client & Server safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-ref.supabase.co

# Staging Supabase Anon Public Key (Client & Server safe, enforced by PostgreSQL RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-staging-anon-key...

# Staging Supabase Service Role Key (SERVER ONLY - NEVER prefix with NEXT_PUBLIC_)
# Bypasses RLS for trusted background jobs, system audits, and scheduled maintenance
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-staging-service-role-key...

# --------------------------------------------------------------------
# 2. Environment Designation
# --------------------------------------------------------------------
NEXT_PUBLIC_APP_ENV=staging

# --------------------------------------------------------------------
# 3. Distributed Rate Limiter & Cache (Optional - Upstash Redis)
# --------------------------------------------------------------------
# Leave blank to use built-in Tier 2 (PostgreSQL atomic RPC) and Tier 3 (In-Memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --------------------------------------------------------------------
# 4. AI Vision & Pathology Diagnostics (AI Crop Doctor)
# --------------------------------------------------------------------
# Server-side only: Google Gemini 2.5 Flash API Key (Primary)
GEMINI_API_KEY=AIzaSy...
AI_API_KEY=

# Server-side only: OpenAI API Key (Secondary / Fallback)
OPENAI_API_KEY=

# --------------------------------------------------------------------
# 5. Weather Telemetry Services
# --------------------------------------------------------------------
# AgriAI defaults to Open-Meteo (Free, high-precision, no key required).
# Optional: WeatherAPI.com API key
WEATHER_API_KEY=

# --------------------------------------------------------------------
# 6. Interactive Mapping (Optional)
# --------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --------------------------------------------------------------------
# 7. Logging & Diagnostics
# --------------------------------------------------------------------
LOG_LEVEL=info
FORCE_JSON_LOGS=true
